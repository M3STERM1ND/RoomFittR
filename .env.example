# RoomFittR environment — template. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit a filled-in copy: this file is the
# only one that belongs in the repo, and it must never contain a real value.
#
# Provisioning instructions for every service below: docs/infrastructure-setup.md
#
# Naming convention. NEXT_PUBLIC_* is compiled into the browser bundle and is
# world-readable — treat every one of them as published. Everything else is
# server-only and must never be referenced from a client component.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Postgres, Auth, Realtime (§1.1)
# Separate dev and prod projects. Dev credentials go in .env.local; prod
# credentials live only in Vercel and Modal secrets, never on a laptop.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row-Level Security completely. Workers and trusted server routes
# only. If this ever reaches the browser, every user's rooms are readable.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations and workers (pooled port 6543 for
# serverless, 5432 for migrations).
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — videos, frames, point clouds, GLBs (§1.1, §2.4)
# Two buckets: roomfittr-dev and roomfittr-prod. Both private; all browser
# access is via presigned URLs.
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=roomfittr-dev
R2_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com

# Public r2.dev or custom-domain base for assets that are genuinely public
# (catalog product thumbnails). Room scans are never served from here.
NEXT_PUBLIC_R2_PUBLIC_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# Modal — GPU/CPU workers and cron (§1.1)
# ─────────────────────────────────────────────────────────────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=dev

# Shared secret on the dispatch endpoint, so only our API can start a GPU job.
# Generate with: openssl rand -hex 32
MODAL_DISPATCH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic — layout planning, catalog tagging (§1.1)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_LAYOUT_MODEL=claude-sonnet-5
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────────────────────────────────────
# Hugging Face — gated checkpoints (docs/model-licenses.md)
# facebook/VGGT-1B-Commercial and the SAM 3 weights are gated: the access
# request must be approved on the account this token belongs to, or the Modal
# image build fails at download time rather than at request time.
# ─────────────────────────────────────────────────────────────────────────────
HF_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — errors from web and workers (§1.1)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Source-map upload at build time only. Not needed to run locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────────────
# Cost guardrails (§1.3). Enforced before dispatch, not after the bill.
# ─────────────────────────────────────────────────────────────────────────────
MAX_SCANS_PER_USER_PER_DAY=5
MAX_GPU_MINUTES_PER_DAY=120
SCAN_JOB_TIMEOUT_S=1800
