{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://roomfittr.app/schemas/common.schema.json",
  "title": "Common",
  "description": "Shared primitives. Defined once so the four documents cannot drift apart on units, id shapes or enum spellings.",
  "definitions": {
    "schema_version": {
      "description": "Version of the schema set the document was written against.",
      "type": "integer",
      "minimum": 0
    },

    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },

    "unit_interval": { "type": "number", "minimum": 0, "maximum": 1 },

    "point2_mm": {
      "description": "[x, z] on the floor plane, integer millimetres.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer" }
    },

    "size3_mm": {
      "description": "[width, depth, height], integer millimetres, all positive.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "exclusiveMinimum": 0 }
    },

    "yaw_deg": {
      "description": "Degrees about +Y. An item's local front is -Z before rotation (2.4).",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },

    "wall_id": { "type": "string", "pattern": "^W[0-9]+$" },
    "opening_id": { "type": "string", "pattern": "^O[0-9]+$" },
    "obstacle_id": { "type": "string", "pattern": "^F[0-9]+$" },
    "object_id": { "type": "string", "pattern": "^B[0-9]+$" },
    "slot_id": { "type": "string", "pattern": "^S[0-9]+$" },
    "item_id": { "type": "string", "minLength": 1, "maxLength": 64 },

    "money_cents": {
      "description": "Integer cents plus ISO 4217 code. Never a float (2.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_cents", "currency"],
      "properties": {
        "amount_cents": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },

    "surface_appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "material": { "type": "string", "minLength": 1 },
        "texture_ref": { "type": "string", "minLength": 1 }
      }
    },

    "warning_code": {
      "description": "Closed list, straight from the known limitations in 3.11 plus the scale caveat. Closed on purpose: a free-text warning cannot be counted, tested or translated.",
      "enum": [
        "MIRROR_OR_GLASS_DETECTED",
        "LOW_LIGHT",
        "STRONG_BACKLIGHT",
        "CURVED_WALL_APPROXIMATED",
        "SLOPED_CEILING_UNSUPPORTED",
        "MULTI_LEVEL_FLOOR_UNSUPPORTED",
        "OPEN_BOUNDARY_PRESENT",
        "WALL_BASE_OCCLUDED",
        "DOOR_POSSIBLY_MISSED",
        "DOOR_SWING_UNKNOWN",
        "CEILING_NOT_OBSERVED",
        "SCALE_UNCALIBRATED",
        "LOW_COVERAGE"
      ]
    },

    "footprint": {
      "description": "An oriented rectangle on the floor plus a height interval. The validator's only geometric primitive for items (5.5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "size", "rotation_deg", "elevation_mm"],
      "properties": {
        "center": { "$ref": "#/definitions/point2_mm" },
        "size": { "$ref": "#/definitions/size3_mm" },
        "rotation_deg": { "$ref": "#/definitions/yaw_deg" },
        "elevation_mm": {
          "description": "Height of the item's underside above the floor. 0 for floor-standing items.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
